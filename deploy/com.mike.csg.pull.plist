<?xml version="1.0" encoding="UTF-8"?>
<!--
  本地定时拉取：每天 23:20（BJ）把 Oracle 上刚生成的提交文件取回本机，
  这样"文件在哪、要不要上传"不需要靠记忆。

  安装（由 scripts/sync.sh install-local 自动完成路径替换与加载）：
      scripts/sync.sh install-local
  卸载：
      scripts/sync.sh uninstall-local
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mike.csg.pull</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT__/scripts/sync.sh</string>
        <string>down</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>23</integer>
            <key>Minute</key><integer>20</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>23</integer>
            <key>Minute</key><integer>50</integer>
        </dict>
    </array>

    <!-- 机器在触发时刻休眠时，唤醒后补跑一次 -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__PROJECT__/data/out/runs/local_pull.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT__/data/out/runs/local_pull.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
